{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudWatchLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/S3BucketCleanupFunction:*"
    },
    {
      "Sid": "ScopedS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::devops-s3-cleanup-demo-2026",
        "arn:aws:s3:::devops-s3-cleanup-demo-2026/*"
      ]
    }
  ]
}